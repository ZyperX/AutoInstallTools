#!/usr/bin/env bash
# AutoInstallTools CLI. Catalog-driven install/list, plus thin wrappers around
# the existing doctor/update/uninstall scripts.
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/common.sh
source "$ROOT/lib/common.sh"
for _lib in apt golang cargo node npm pipx github awscli verify manifest catalog dispatch; do
  # shellcheck disable=SC1090
  source "$ROOT/lib/$_lib.sh"
done
for _m in github_release uv git_venv docker official_archive manual; do
  # shellcheck disable=SC1090
  source "$ROOT/lib/methods/$_m.sh"
done
# shellcheck source=lib/menu.sh
source "$ROOT/lib/menu.sh"
# shellcheck source=lib/mobile.sh
source "$ROOT/lib/mobile.sh"

usage() {
  cat <<'EOF'
Usage: ait <command> [options]

Commands:
  (none)     Open the interactive menu
  menu       Open the interactive menu
  list       Show the catalog (optionally filtered by profile/category)
  install    Install a profile's tools (resolved from the catalog)
  doctor     Check installed tools
  update     Update apt, runtimes, release tools, templates & wordlists
  uninstall  Remove AutoInstallTools-managed files
  frida-server  Push and start a matching frida-server on the device
  proxy-ca      Prepare a proxy CA as Android's <subject_hash_old>.0

Install/list options:
  --profile NAME     one of: minimal web api mobile code vps all ai
  --with a,b         add tools or tags on top of the profile
  --without a,b      remove tools or tags from the profile
  --dry-run          (install) show what would happen, change nothing
  --yes              (install) do not prompt for confirmation
  --no-shell         (install) skip editing your shell rc
  --category NAME    (list) show only one category (android, recon, vuln, ...)
  --installed        (list) show only tools already present
  --json             (list) machine-readable output

Examples:
  ait list
  ait list --profile web
  ait install --profile web --without amass --dry-run
  ait install --profile mobile --with ghidra --yes
  ait frida-server --device emulator-5554
  ait proxy-ca --burp ~/Downloads/cacert.der
EOF
}

# --- argument parsing shared by list/install ---
PROFILE=''; WITH=''; WITHOUT=''; JSON=0; INSTALLED_ONLY=0; CATEGORY=''
parse_common_args() {
  while (($#)); do
    case "$1" in
      --profile) PROFILE=$2; shift 2 ;;
      --category) CATEGORY=$2; shift 2 ;;
      --category=*) CATEGORY=${1#*=}; shift ;;
      --profile=*) PROFILE=${1#*=}; shift ;;
      --with) WITH=$2; shift 2 ;;
      --with=*) WITH=${1#*=}; shift ;;
      --without) WITHOUT=$2; shift 2 ;;
      --without=*) WITHOUT=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --yes|-y) ASSUME_YES=1; shift ;;
      --no-shell) NO_SHELL=1; shift ;;
      --installed) INSTALLED_ONLY=1; shift ;;
      --json) JSON=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
}

# names to list: resolved profile set, or the whole catalog when no profile.
_selected_names() {
  if [[ -n "$PROFILE" ]]; then
    catalog_profile_exists "$PROFILE" || die "Unknown profile: $PROFILE"
    resolve_tools "$PROFILE" "$WITH" "$WITHOUT"
  else
    catalog_tool_names | sort
  fi
}

ait_list() {
  parse_common_args "$@"
  bootstrap_yq
  # Set of names to show (newline-delimited); grep -Fxq tests membership.
  local names; names=$(_selected_names)

  if [[ -n "$CATEGORY" ]]; then
    local cats; cats=$(catalog_categories)
    grep -qx -- "$CATEGORY" <<< "$cats" || die "Unknown category: $CATEGORY (one of: $(paste -sd, - <<< "$cats"))"
  fi

  # One catalog pass gives name/desc/bin/category (other columns ignored).
  local name desc bin cat present first=1
  if ((JSON)); then printf '['; else printf '%-24s %-10s %-14s %s\n' 'TOOL' 'STATUS' 'CATEGORY' 'DESCRIPTION'; fi

  while IFS=$'\t' read -r name _ _ desc _ bin cat; do
    [[ -z "$name" ]] && continue
    [[ -n "$CATEGORY" && "$cat" != "$CATEGORY" ]] && continue
    grep -Fxq "$name" <<< "$names" || continue
    present=false; command -v "$bin" >/dev/null 2>&1 && present=true
    ((INSTALLED_ONLY)) && [[ "$present" == false ]] && continue
    if ((JSON)); then
      ((first)) || printf ','; first=0
      printf '{"name":"%s","category":"%s","installed":%s}' "$name" "$cat" "$present"
    else
      local status='-'; [[ "$present" == true ]] && status='installed'
      printf '%-24s %-10s %-14s %s\n' "$name" "$status" "$cat" "$desc"
    fi
  done < <(catalog_tools_tsv)

  ((JSON)) && printf ']\n'
  return 0
}

ait_install() {
  parse_common_args "$@"
  [[ -n "$PROFILE" ]] || die 'install needs --profile (see: ait list --profile ...)'
  require_linux
  bootstrap_yq
  catalog_profile_exists "$PROFILE" || die "Unknown profile: $PROFILE"

  local names; names=$(resolve_tools "$PROFILE" "$WITH" "$WITHOUT")
  local count; count=$(grep -c . <<< "$names")
  log "Profile '$PROFILE' resolves to $count tool(s):"
  printf '%s\n' "$names" | sed 's/^/  - /'
  dryrun && log '(dry-run: nothing will be installed)'

  if ((${ASSUME_YES:-0} == 0)) && ! dryrun && [[ -t 0 && ${CI:-} != true ]]; then
    read -r -p "Proceed? [y/N] " a; [[ "$a" =~ ^[Yy]$ ]] || exit 0
  fi

  local arr=()
  mapfile -t arr <<< "$names"
  ait_install_names "$PROFILE" "${arr[@]}"
}

# ait_install_names <label> <tool...> — install an explicit list. Shared by the
# CLI (profile resolution) and the interactive menu (manual selection).
ait_install_names() {
  local label=$1; shift
  [[ $# -gt 0 ]] || { warn 'No tools selected.'; return 0; }
  PROFILE=$label; export PROFILE
  init_paths; manifest_init; acquire_lock; trap release_lock EXIT; begin_failure_report
  local name
  for name in "$@"; do
    [[ -z "$name" ]] && continue
    catalog_tool_exists "$name" || { warn "$name: not in catalog; skipping"; record_failure "$name" 'not in catalog'; continue; }
    install_tool "$name" || record_failure "$name" 'installer error'
  done
  if ((${NO_SHELL:-0} == 0)); then configure_shell; fi
  report_failures
  # Release eagerly: the interactive menu installs more than once in one process.
  release_lock
}

# Remove one manifest tool by its recorded method + paths.
_uninstall_one() {
  local tool=$1 apt_ok=$2 method paths p
  method=$(manifest_field "$tool" 2); paths=$(manifest_field "$tool" 4)
  IFS=',' read -ra _pp <<< "$paths"
  for p in "${_pp[@]}"; do
    case "$p" in
      pipx:*) pipx_uninstall "${p#pipx:}" ;;
      uv:*)   command -v uv >/dev/null && { uv tool uninstall "${p#uv:}" || true; } ;;
      npm:*)  command -v npm >/dev/null && { npm rm -g "${p#npm:}" || true; } ;;
      cargo:*) command -v cargo >/dev/null && { cargo uninstall "${p#cargo:}" 2>/dev/null || true; } ;;
      runtime:*) warn "$tool: leaving runtime '${p#runtime:}' in place" ;;
      apt:*)
        local pk=${p#apt:}; pk=${pk//,/ }
        if ((apt_ok)); then
          # shellcheck disable=SC2086  # intentional word-split: multiple packages
          run sudo apt-get remove -y $pk || true
        else warn "$tool: apt packages left in place (use --apt): $pk"; fi ;;
      '' | '-') : ;;
      *) run rm -rf -- "$p" ;;
    esac
  done
  manifest_remove_row "$tool"
  ok "Removed $tool"
}

ait_uninstall() {
  local all=0 apt_ok=0 tools=''
  while (($#)); do case "$1" in
    --all) all=1; shift ;;
    --tools) tools=$2; shift 2 ;;
    --tools=*) tools=${1#*=}; shift ;;
    --apt) apt_ok=1; shift ;;
    --yes | -y) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h | --help) usage; exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac; done
  manifest_init
  local list
  if ((all)); then list=$(manifest_tools)
  elif [[ -n "$tools" ]]; then list=$(tr ',' '\n' <<< "$tools")
  else die 'uninstall needs --all or --tools a,b'; fi
  [[ -n "$list" ]] || { log 'Nothing recorded in the manifest to remove.'; return 0; }

  log 'Will remove:'; printf '%s\n' "$list" | sed 's/^/  - /'
  if ((${ASSUME_YES:-0} == 0)) && ! dryrun && [[ -t 0 && ${CI:-} != true ]]; then
    read -r -p 'Proceed? [y/N] ' a; [[ "$a" =~ ^[Yy]$ ]] || exit 0
  fi
  local t
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    manifest_has "$t" || { warn "$t: not in manifest; skipping"; continue; }
    _uninstall_one "$t" "$apt_ok"
  done <<< "$list"

  if ((all)) && ! dryrun; then
    for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
      [[ -f "$rc" ]] && sed -i '/# >>> AIT >>>/,/# <<< AIT <<</d' "$rc"
    done
  fi
}

ait_doctor() {
  local json=0; [[ "${1:-}" == --json ]] && json=1
  bootstrap_yq
  ((json)) && printf '['
  local first=1 name method desc bin status ver want chk
  while IFS=$'\t' read -r name _ method desc _ bin _; do
    [[ -z "$name" ]] && continue
    if ! command -v "$bin" >/dev/null 2>&1; then
      if manifest_has "$name"; then status=missing; else continue; fi
    else
      chk=$(catalog_tool_field "$name" check)
      if [[ -n "$chk" ]]; then
        if timeout 10 bash -c "$chk" >/dev/null 2>&1; then status=ok; else status=broken; fi
      else status=ok; fi
      want=$(catalog_tool_field "$name" version)
      ver=$(manifest_field "$name" 3 2>/dev/null); ver=${ver:--}
      if [[ "$method" == github_release || "$method" == official_archive ]]; then
        if [[ -z "$want" ]]; then
          [[ "$status" == ok ]] && status=unpinned
        elif [[ -n "$ver" && "$ver" != - && "$ver" != "$want" ]]; then
          [[ "$status" == ok ]] && status=outdated
        fi
      fi
    fi
    ver=$(manifest_field "$name" 3 2>/dev/null); ver=${ver:--}
    if ((json)); then
      ((first)) || printf ','; first=0
      printf '{"name":"%s","status":"%s","version":"%s"}' "$name" "$status" "$ver"
    else
      printf '%-24s %-10s %-12s %s\n' "$name" "$status" "$ver" "$desc"
    fi
  done < <(catalog_tools_tsv)
  ((json)) && { printf ']\n'; return 0; }

  case ":$PATH:" in *":$BIN_DIR:"*) ok "PATH has $BIN_DIR" ;; *) warn "$BIN_DIR not on PATH" ;; esac
  case ":$PATH:" in *":$HOME/go/bin:"*) ok "PATH has $HOME/go/bin" ;; *) warn "$HOME/go/bin not on PATH" ;; esac
  if is_wsl; then
    ok 'WSL detected'
    if [[ -d /mnt/wslg ]]; then ok 'WSLg present (GUI apps supported)'; else warn 'WSLg not detected'; fi
  fi
  mobile_adb_report
  local tdir="$HOME/.local/nuclei-templates"
  if [[ -d "$tdir" && -n "$(find "$tdir" -maxdepth 0 -mtime +14 2>/dev/null)" ]]; then warn 'nuclei templates >14 days old (ait update)'; fi
  if command -v frida >/dev/null 2>&1 && command -v adb >/dev/null 2>&1; then
    local hv dv
    hv=$(frida --version 2>/dev/null || true)
    dv=$(adb shell /data/local/tmp/frida-server --version 2>/dev/null | tr -d '\r' || true)
    if [[ -n "$hv" && -n "$dv" && "$hv" != "$dv" ]]; then
      warn "Frida host ($hv) and device server ($dv) versions differ"
    elif [[ -n "$hv" ]]; then ok "Frida host: $hv"; fi
  fi
  local free_kb
  free_kb=$(df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
  if [[ "$free_kb" =~ ^[0-9]+$ ]] && ((free_kb < 5 * 1024 * 1024)); then
    warn "Low disk space: $((free_kb / 1024)) MiB free in $HOME"
  fi
  return 0
}

ait_update() {
  local tools=''
  while (($#)); do case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --tools) tools=$2; shift 2 ;;
    --tools=*) tools=${1#*=}; shift ;;
    -h | --help) usage; exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac; done
  require_linux; bootstrap_yq; init_paths; manifest_init; acquire_lock; trap release_lock EXIT; begin_failure_report
  export FORCE_INSTALL=1
  local t list
  if [[ -n "$tools" ]]; then list=$(tr ',' '\n' <<< "$tools"); else list=$(manifest_tools); fi
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    catalog_tool_exists "$t" || { warn "$t: not in catalog; skipping"; continue; }
    log "Updating $t"; install_tool "$t" || record_failure "$t" 'update error'
  done <<< "$list"
  command -v pdtm >/dev/null && { pdtm -ua || true; }
  command -v nuclei >/dev/null && { nuclei -update-templates || true; }
  report_failures
  release_lock
}

main() {
  local cmd=${1:-}
  (($#)) && shift
  case "$cmd" in
    list) ait_list "$@" ;;
    install) ait_install "$@" ;;
    doctor) ait_doctor "$@" ;;
    update) ait_update "$@" ;;
    uninstall) ait_uninstall "$@" ;;
    frida-server) ait_frida_server "$@" ;;
    proxy-ca) ait_proxy_ca "$@" ;;
    '' | menu) menu_main ;;
    -h | --help | help) usage ;;
    *) die "Unknown command: $cmd (try: ait --help)" ;;
  esac
}
main "$@"
