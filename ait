#!/usr/bin/env bash
# AutoInstallTools CLI. Catalog-driven install/list, plus thin wrappers around
# the existing doctor/update/uninstall scripts.
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/common.sh
source "$ROOT/lib/common.sh"
for _lib in apt golang cargo node npm pipx github awscli verify manifest catalog dispatch; do
  # shellcheck disable=SC1090
  source "$ROOT/lib/$_lib.sh"
done
for _m in github_release uv git_venv docker official_archive manual; do
  # shellcheck disable=SC1090
  source "$ROOT/lib/methods/$_m.sh"
done

usage() {
  cat <<'EOF'
Usage: ait <command> [options]

Commands:
  list       Show the catalog (optionally filtered by profile)
  install    Install a profile's tools (resolved from the catalog)
  doctor     Check installed tools
  update     Update apt, runtimes, release tools, templates & wordlists
  uninstall  Remove AutoInstallTools-managed files

Install/list options:
  --profile NAME     one of: minimal web api mobile code vps full ai
  --with a,b         add tools or tags on top of the profile
  --without a,b      remove tools or tags from the profile
  --dry-run          (install) show what would happen, change nothing
  --yes              (install) do not prompt for confirmation
  --no-shell         (install) skip editing your shell rc
  --installed        (list) show only tools already present
  --json             (list) machine-readable output

Examples:
  ait list
  ait list --profile web
  ait install --profile web --without amass --dry-run
  ait install --profile mobile --with ghidra --yes
EOF
}

# --- argument parsing shared by list/install ---
PROFILE=''; WITH=''; WITHOUT=''; JSON=0; INSTALLED_ONLY=0
parse_common_args() {
  while (($#)); do
    case "$1" in
      --profile) PROFILE=$2; shift 2 ;;
      --profile=*) PROFILE=${1#*=}; shift ;;
      --with) WITH=$2; shift 2 ;;
      --with=*) WITH=${1#*=}; shift ;;
      --without) WITHOUT=$2; shift 2 ;;
      --without=*) WITHOUT=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --yes|-y) ASSUME_YES=1; shift ;;
      --no-shell) NO_SHELL=1; shift ;;
      --installed) INSTALLED_ONLY=1; shift ;;
      --json) JSON=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
}

# names to list: resolved profile set, or the whole catalog when no profile.
_selected_names() {
  if [[ -n "$PROFILE" ]]; then
    catalog_profile_exists "$PROFILE" || die "Unknown profile: $PROFILE"
    resolve_tools "$PROFILE" "$WITH" "$WITHOUT"
  else
    catalog_tool_names | sort
  fi
}

ait_list() {
  parse_common_args "$@"
  bootstrap_yq
  # Set of names to show (newline-delimited); grep -Fxq tests membership.
  local names; names=$(_selected_names)

  # One catalog pass gives name/desc/bin for every tool (other columns ignored).
  local name desc bin present first=1
  if ((JSON)); then printf '['; else printf '%-24s %-10s %s\n' 'TOOL' 'STATUS' 'DESCRIPTION'; fi

  while IFS=$'\t' read -r name _ _ desc _ bin; do
    [[ -z "$name" ]] && continue
    grep -Fxq "$name" <<< "$names" || continue
    present=false; command -v "$bin" >/dev/null 2>&1 && present=true
    ((INSTALLED_ONLY)) && [[ "$present" == false ]] && continue
    if ((JSON)); then
      ((first)) || printf ','; first=0
      printf '{"name":"%s","installed":%s}' "$name" "$present"
    else
      local status='-'; [[ "$present" == true ]] && status='installed'
      printf '%-24s %-10s %s\n' "$name" "$status" "$desc"
    fi
  done < <(catalog_tools_tsv)

  ((JSON)) && printf ']\n'
  return 0
}

ait_install() {
  parse_common_args "$@"
  [[ -n "$PROFILE" ]] || die 'install needs --profile (see: ait list --profile ...)'
  require_linux
  bootstrap_yq
  catalog_profile_exists "$PROFILE" || die "Unknown profile: $PROFILE"

  local names; names=$(resolve_tools "$PROFILE" "$WITH" "$WITHOUT")
  local count; count=$(grep -c . <<< "$names")
  log "Profile '$PROFILE' resolves to $count tool(s):"
  printf '%s\n' "$names" | sed 's/^/  - /'
  dryrun && log '(dry-run: nothing will be installed)'

  if ((${ASSUME_YES:-0} == 0)) && ! dryrun && [[ -t 0 && ${CI:-} != true ]]; then
    read -r -p "Proceed? [y/N] " a; [[ "$a" =~ ^[Yy]$ ]] || exit 0
  fi

  init_paths; manifest_init; acquire_lock; trap release_lock EXIT; begin_failure_report
  export PROFILE
  local name
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    install_tool "$name" || record_failure "$name" 'installer error'
  done <<< "$names"

  if ((${NO_SHELL:-0} == 0)); then configure_shell; fi
  report_failures
}

# Remove one manifest tool by its recorded method + paths.
_uninstall_one() {
  local tool=$1 apt_ok=$2 method paths p
  method=$(manifest_field "$tool" 2); paths=$(manifest_field "$tool" 4)
  IFS=',' read -ra _pp <<< "$paths"
  for p in "${_pp[@]}"; do
    case "$p" in
      pipx:*) pipx_uninstall "${p#pipx:}" ;;
      npm:*)  command -v npm >/dev/null && { npm rm -g "${p#npm:}" || true; } ;;
      cargo:*) command -v cargo >/dev/null && { cargo uninstall "${p#cargo:}" 2>/dev/null || true; } ;;
      runtime:*) warn "$tool: leaving runtime '${p#runtime:}' in place" ;;
      apt:*)
        local pk=${p#apt:}; pk=${pk//,/ }
        if ((apt_ok)); then
          # shellcheck disable=SC2086  # intentional word-split: multiple packages
          run sudo apt-get remove -y $pk || true
        else warn "$tool: apt packages left in place (use --apt): $pk"; fi ;;
      '' | '-') : ;;
      *) run rm -rf -- "$p" ;;
    esac
  done
  manifest_remove_row "$tool"
  ok "Removed $tool"
}

ait_uninstall() {
  local all=0 apt_ok=0 tools=''
  while (($#)); do case "$1" in
    --all) all=1; shift ;;
    --tools) tools=$2; shift 2 ;;
    --tools=*) tools=${1#*=}; shift ;;
    --apt) apt_ok=1; shift ;;
    --yes | -y) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h | --help) usage; exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac; done
  manifest_init
  local list
  if ((all)); then list=$(manifest_tools)
  elif [[ -n "$tools" ]]; then list=$(tr ',' '\n' <<< "$tools")
  else die 'uninstall needs --all or --tools a,b'; fi
  [[ -n "$list" ]] || { log 'Nothing recorded in the manifest to remove.'; return 0; }

  log 'Will remove:'; printf '%s\n' "$list" | sed 's/^/  - /'
  if ((${ASSUME_YES:-0} == 0)) && ! dryrun && [[ -t 0 && ${CI:-} != true ]]; then
    read -r -p 'Proceed? [y/N] ' a; [[ "$a" =~ ^[Yy]$ ]] || exit 0
  fi
  local t
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    manifest_has "$t" || { warn "$t: not in manifest; skipping"; continue; }
    _uninstall_one "$t" "$apt_ok"
  done <<< "$list"

  if ((all)) && ! dryrun; then
    for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
      [[ -f "$rc" ]] && sed -i '/# >>> AIT >>>/,/# <<< AIT <<</d' "$rc"
    done
  fi
}

ait_doctor() {
  local json=0; [[ "${1:-}" == --json ]] && json=1
  bootstrap_yq
  ((json)) && printf '['
  local first=1 name tagcsv method desc optin bin status ver chk
  while IFS=$'\t' read -r name tagcsv method desc optin bin; do
    [[ -z "$name" ]] && continue
    if ! command -v "$bin" >/dev/null 2>&1; then
      manifest_has "$name" && status=missing || continue
    else
      chk=$(catalog_tool_field "$name" check)
      if [[ -n "$chk" ]]; then
        if timeout 10 bash -c "$chk" >/dev/null 2>&1; then status=ok; else status=broken; fi
      else status=ok; fi
      if [[ "$method" == github_release || "$method" == official_archive ]] && [[ -z "$(catalog_tool_field "$name" version)" ]]; then
        [[ "$status" == ok ]] && status=unpinned
      fi
    fi
    ver=$(manifest_field "$name" 3 2>/dev/null); ver=${ver:--}
    if ((json)); then
      ((first)) || printf ','; first=0
      printf '{"name":"%s","status":"%s","version":"%s"}' "$name" "$status" "$ver"
    else
      printf '%-24s %-10s %s\n' "$name" "$status" "$desc"
    fi
  done < <(catalog_tools_tsv)
  ((json)) && { printf ']\n'; return 0; }

  case ":$PATH:" in *":$BIN_DIR:"*) ok "PATH has $BIN_DIR" ;; *) warn "$BIN_DIR not on PATH" ;; esac
  case ":$PATH:" in *":$HOME/go/bin:"*) ok 'PATH has ~/go/bin' ;; *) warn '~/go/bin not on PATH' ;; esac
  if is_wsl; then
    ok 'WSL detected'
    if [[ -d /mnt/wslg ]]; then ok 'WSLg present (GUI apps supported)'; else warn 'WSLg not detected'; fi
  fi
  if command -v adb >/dev/null 2>&1; then
    local devs; devs=$(adb devices 2>/dev/null | grep -cE "$(printf '\t')device$" || true)
    if ((devs > 0)); then ok "adb: $devs device(s) connected"; else warn 'adb: no devices connected'; fi
  fi
  local tdir="$HOME/.local/nuclei-templates"
  if [[ -d "$tdir" && -n "$(find "$tdir" -maxdepth 0 -mtime +14 2>/dev/null)" ]]; then warn 'nuclei templates >14 days old (ait update)'; fi
  return 0
}

ait_update() {
  while (($#)); do case "$1" in --dry-run) DRY_RUN=1; shift ;; -h | --help) usage; exit 0 ;; *) die "Unknown option: $1" ;; esac; done
  require_linux; bootstrap_yq; init_paths; manifest_init; acquire_lock; trap release_lock EXIT; begin_failure_report
  export FORCE_INSTALL=1
  local t
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    catalog_tool_exists "$t" || { warn "$t: not in catalog; skipping"; continue; }
    log "Updating $t"; install_tool "$t" || record_failure "$t" 'update error'
  done <<< "$(manifest_tools)"
  command -v pdtm >/dev/null && { pdtm -ua || true; }
  command -v nuclei >/dev/null && { nuclei -update-templates || true; }
  report_failures
}

main() {
  local cmd=${1:-}
  (($#)) && shift
  case "$cmd" in
    list) ait_list "$@" ;;
    install) ait_install "$@" ;;
    doctor) ait_doctor "$@" ;;
    update) ait_update "$@" ;;
    uninstall) ait_uninstall "$@" ;;
    '' | menu) warn 'The interactive menu arrives in a later phase; use: ait install --profile ...'; usage; exit 0 ;;
    -h | --help | help) usage ;;
    *) die "Unknown command: $cmd (try: ait --help)" ;;
  esac
}
main "$@"
